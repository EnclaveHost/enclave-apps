[Unit]
Description=EnclaveDNS Local sockets (.eth DNS and sites on 127.0.0.3)
Documentation=https://github.com/EnclaveHost/enclave-apps/tree/main/enclavedns/local
Before=nss-lookup.target

[Socket]
# systemd holds these, so a browser never meets a closed port while the
# service starts or restarts
ListenStream=127.0.0.3:80
ListenStream=127.0.0.3:443
ListenStream=127.0.0.3:53
ListenDatagram=127.0.0.3:53
FreeBind=true

[Install]
WantedBy=sockets.target
