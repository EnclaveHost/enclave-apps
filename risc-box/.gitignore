images/
# The emulator is a path dependency; the app's lockfile is the one that counts.
# This one only appears because `--example boot-bench` builds from emu's own
# manifest.
emu/Cargo.lock
set/*.wasm

# wasm64: the proxy is a cargo crate of its own; the raw (unproxied) component is an intermediate
wasm64/wasiproxy/target/
wasm64/*.wasm
