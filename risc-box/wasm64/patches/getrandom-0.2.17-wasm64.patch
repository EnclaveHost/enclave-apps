-//! Implementation for WASI
+// Implementation for WASI.
+//
+// wasip1 (and wasm32-wasip2, where rustc's bundled adapter serves preview1
+// imports) goes through the `wasi` crate's preview1 `random_get`. A wasm64
+// wasip2 build has no adapter — the bundled one is a wasm32 module that
+// cannot address a 64-bit memory — so the p2 arm asks the wasi 0.2 `random`
+// interface directly, as getrandom 0.3+ does.
 use crate::Error;
-use core::{
-    mem::MaybeUninit,
-    num::{NonZeroU16, NonZeroU32},
-};
-use wasi::random_get;
+use core::mem::MaybeUninit;
 
+#[cfg(all(target_env = "p2", target_arch = "wasm64"))]
 pub fn getrandom_inner(dest: &mut [MaybeUninit<u8>]) -> Result<(), Error> {
+    let bytes = wasip2::random::random::get_random_bytes(dest.len() as u64);
+    if bytes.len() != dest.len() {
+        return Err(Error::UNEXPECTED);
+    }
+    for (d, s) in dest.iter_mut().zip(bytes.iter()) {
+        d.write(*s);
+    }
+    Ok(())
+}
