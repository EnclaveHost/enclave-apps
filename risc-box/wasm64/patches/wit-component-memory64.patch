+// `i64` when the module's memory is a 64-bit memory. wit-component learns
+// that from the main module's memory section (see `ValidatedModule::new`)
+// and every place that flattens a signature consults it. One flag for the
+// process: an encoder handles one main module, and its shims and adapters
+// must agree with it anyway.
+pub(crate) static PTR64: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub(crate) fn ptr64() -> bool {
+    PTR64.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+pub(crate) fn ptr_val_type() -> ValType {
+    if ptr64() { ValType::I64 } else { ValType::I32 }
+}
