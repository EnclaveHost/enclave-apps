diff --git a/libc-bottom-half/sources/__wasilibc_real_wasm64.inc b/libc-bottom-half/sources/__wasilibc_real_wasm64.inc
new file mode 100644
index 0000000..8c7e8ba
--- /dev/null
+++ b/libc-bottom-half/sources/__wasilibc_real_wasm64.inc
@@ -0,0 +1,997 @@
+/**
+ * enclave wasm64 marshalling shim — the body of __wasilibc_real.c when
+ * compiling for wasm64 (memory64). See wasm/wasi-libc-mem64.patch in the
+ * enclave tree for how this file enters the build.
+ *
+ * WHY THIS EXISTS. There is no 64-bit WASI preview1 ABI: the host (wasmtime)
+ * exposes exactly one wasi_snapshot_preview1, typed for wasm32 — every
+ * pointer and size crosses as i32, and every pointer-bearing structure the
+ * host reads or writes in guest memory uses the wasm32 layout (iovec is
+ * {u32,u32}, size_t results are u32, argv tables are u32[]). A memory64
+ * guest may still IMPORT those functions (function signatures are
+ * independent of memory width, and the engine indexes the 64-bit memory
+ * through the i32 offsets just fine) — verified against the enclave
+ * wasmtime 49 build. So a wasm64 libc keeps its natural LP64 types at the
+ * C level and translates at this one boundary instead:
+ *
+ *   - anything the host must address has to live BELOW 4 GiB and is passed
+ *     truncated; wasm-ld places data + stack low, so in practice only
+ *     heap-derived pointers past the 4 GiB waterline ever need help;
+ *   - buffers above the line bounce through a static low arena, chunked —
+ *     the read/write family legally returns short counts (every libc
+ *     caller already loops), and full-fill calls (random_get) loop here;
+ *   - pointer-width'd layouts are rebuilt: iovec arrays are re-staged in
+ *     wasm32 shape, size_t out-params come back through u32 slots and are
+ *     widened, argv/environ pointer tables are rebased from the staged
+ *     copy, prestat is expanded from the 8-byte host form.
+ *
+ * Single-threaded by construction (the wasm64 sysroot builds with
+ * -mthread-model single and no _REENTRANT), which is what makes the static
+ * arena and slots sound.
+ */
+
+#include <stdint.h>
+
+#ifdef _REENTRANT
+#error "the wasm64 marshalling shim is single-threaded; build without _REENTRANT"
+#endif
+
+/* Host-facing pointer: the truncation the whole scheme rests on. Only ever
+ * applied to addresses m64_fits() approved (or arena/slot statics, which the
+ * first marshalling call proves are low). */
+#define M64P(p) ((int32_t)(uintptr_t)(p))
+
+/* Layout-identical structures the host reads/writes in place: these carry no
+ * pointers and no size_t, so their bytes mean the same thing on both ABIs.
+ * If a wasi-libc bump ever changes one, fail the BUILD, not the tenant. */
+_Static_assert(sizeof(__wasi_fdstat_t) == 24, "fdstat layout drifted");
+_Static_assert(sizeof(__wasi_filestat_t) == 64, "filestat layout drifted");
+_Static_assert(sizeof(__wasi_subscription_t) == 48, "subscription layout drifted");
+_Static_assert(sizeof(__wasi_event_t) == 32, "event layout drifted");
+_Static_assert(sizeof(__wasi_dirent_t) == 24, "dirent layout drifted");
+/* And the two the shim itself rebuilds — the GUEST-side (LP64) views: */
+_Static_assert(sizeof(__wasi_ciovec_t) == 16, "wasm64 ciovec must be {u64,u64}");
+_Static_assert(sizeof(__wasi_prestat_t) == 16, "wasm64 prestat must be 16 bytes");
+
+/* Can the host address this range directly? (base and one-past-end both
+ * within the first 4 GiB — host offsets are u32.) */
+static inline int m64_fits(const void *p, uint64_t len) {
+  uint64_t a = (uint64_t)(uintptr_t)p;
+  return a <= 0xffffffffull && len <= 0x100000000ull - a;
+}
+
+/* The low bounce arena + result slots. Statics sit in the data segment,
+ * which wasm-ld lays out at the bottom of memory; the check traps loudly at
+ * first use if a build ever violates that (a silent wrong-address call is
+ * exactly the corruption class this file exists to prevent). */
+#define M64_IOV_MAX 64
+#define M64_ARENA_LEN (128 * 1024)
+static struct {
+  uint32_t iov[M64_IOV_MAX * 2]; /* staged wasm32 iovec array: {buf,len}… */
+  uint8_t data[M64_ARENA_LEN];   /* staged buffer bytes */
+} __m64;
+static uint8_t *__m64_dst[M64_IOV_MAX]; /* per staged entry: guest dst (reads), or NULL = direct */
+static union {
+  __wasi_filestat_t filestat;
+  __wasi_fdstat_t fdstat;
+  uint64_t u64;
+  uint32_t u32[4];
+} __m64_slot;
+static struct {
+  uint8_t tag;
+  uint8_t pad[3];
+  uint32_t len;
+} __m64_prestat;
+static uint16_t __m64_u16slot;
+
+static void m64_check(void) {
+  static int ok;
+  if (!ok) {
+    if (!m64_fits(&__m64, sizeof(__m64)) ||
+        !m64_fits(__m64_dst, sizeof(__m64_dst)) ||
+        !m64_fits(&__m64_slot, sizeof(__m64_slot)) ||
+        !m64_fits(&__m64_prestat, sizeof(__m64_prestat)) ||
+        !m64_fits(&__m64_u16slot, sizeof(__m64_u16slot)))
+      __builtin_trap();
+    ok = 1;
+  }
+}
+
+/* Stage an iovec/ciovec array (same shape) into wasm32 form. Low buffers are
+ * referenced in place; high ones go through the arena — copied in now for
+ * writes (copy_in), copied back after for reads (m64_unstage). Stops at the
+ * first buffer it cannot cover fully; a short vector is fine because the
+ * read/write family reports short counts and callers loop. */
+static uint32_t m64_stage(const __wasi_ciovec_t *iovs, size_t n, int copy_in) {
+  uint32_t cnt = 0;
+  size_t used = 0;
+  if (n > M64_IOV_MAX)
+    n = M64_IOV_MAX;
+  for (size_t i = 0; i < n; i++) {
+    const uint8_t *buf = iovs[i].buf;
+    uint64_t len = iovs[i].buf_len;
+    if (m64_fits(buf, len)) {
+      __m64.iov[cnt * 2] = (uint32_t)(uintptr_t)buf;
+      __m64.iov[cnt * 2 + 1] = (uint32_t)len;
+      __m64_dst[cnt] = NULL;
+      cnt++;
+      continue;
+    }
+    size_t room = M64_ARENA_LEN - used;
+    if (!room)
+      break;
+    size_t take = len < room ? (size_t)len : room;
+    if (copy_in)
+      memcpy(__m64.data + used, buf, take);
+    __m64.iov[cnt * 2] = (uint32_t)(uintptr_t)(__m64.data + used);
+    __m64.iov[cnt * 2 + 1] = (uint32_t)take;
+    __m64_dst[cnt] = (uint8_t *)buf;
+    cnt++;
+    used += take;
+    if (take < len)
+      break;
+  }
+  return cnt;
+}
+
+/* After a staged READ: copy arena bytes out to the true guest buffers,
+ * walking the staged entries in order and consuming what the host reported. */
+static void m64_unstage(uint32_t cnt, uint64_t nread) {
+  for (uint32_t i = 0; i < cnt && nread; i++) {
+    uint32_t hlen = __m64.iov[i * 2 + 1];
+    uint64_t take = nread < hlen ? nread : hlen;
+    if (__m64_dst[i])
+      memcpy(__m64_dst[i], (const uint8_t *)(uintptr_t)__m64.iov[i * 2],
+             (size_t)take);
+    nread -= take;
+  }
+}
+
+/* Stage a path string. half selects which arena half backs a copy, so the
+ * two-path calls can stage both. Returns the host pointer, or 0 with *err
+ * set (a path that neither sits low nor fits half an arena is not a real
+ * path — report it as too long rather than corrupting the call). */
+static uint32_t m64_path(const char *path, size_t len, int half,
+                         __wasi_errno_t *err) {
+  if (m64_fits(path, len))
+    return (uint32_t)(uintptr_t)path;
+  if (len > M64_ARENA_LEN / 2) {
+    *err = __WASI_ERRNO_NAMETOOLONG;
+    return 0;
+  }
+  uint8_t *dst = __m64.data + (half ? M64_ARENA_LEN / 2 : 0);
+  memcpy(dst, path, len);
+  return (uint32_t)(uintptr_t)dst;
+}
+
+/* Fixed-size out-structure (layout-identical kinds): host pointer to hand
+ * over, and whether a copy-back from the slot is owed on success. */
+#define M64_OUTP(ptr, slotp)                                                   \
+  (m64_fits((ptr), sizeof(*(ptr))) ? M64P(ptr) : M64P(slotp))
+#define M64_OUTFIX(ret, ptr, slotp)                                            \
+  do {                                                                         \
+    if ((ret) == 0 && !m64_fits((ptr), sizeof(*(ptr))))                        \
+      memcpy((ptr), (slotp), sizeof(*(ptr)));                                  \
+  } while (0)
+
+int32_t __imported_wasi_snapshot_preview1_args_get(int32_t arg0, int32_t arg1)
+    __attribute__((__import_module__("wasi_snapshot_preview1"),
+                   __import_name__("args_get")));
+int32_t __imported_wasi_snapshot_preview1_args_sizes_get(int32_t arg0,
+                                                         int32_t arg1)
+    __attribute__((__import_module__("wasi_snapshot_preview1"),
+                   __import_name__("args_sizes_get")));
+
+/* args/environ: the host writes a u32 pointer table into a u32-sized buffer
+ * it addresses — stage both in the arena, then rebase every table entry onto
+ * the caller's (64-bit) buffer and widen. */
+static __wasi_errno_t
+m64_table_get(int32_t (*sizes)(int32_t, int32_t),
+              int32_t (*get)(int32_t, int32_t), uint8_t **vec, uint8_t *buf) {
+  m64_check();
+  int32_t ret = sizes(M64P(&__m64_slot.u32[0]), M64P(&__m64_slot.u32[1]));
+  if (ret != 0)
+    return (uint16_t)ret;
+  uint32_t cnt = __m64_slot.u32[0], bufsz = __m64_slot.u32[1];
+  if ((uint64_t)cnt * 4 + bufsz > M64_ARENA_LEN)
+    return __WASI_ERRNO_NOMEM;
+  uint32_t *hvec = (uint32_t *)__m64.data;
+  uint8_t *hbuf = __m64.data + (uint64_t)cnt * 4;
+  ret = get(M64P(hvec), M64P(hbuf));
+  if (ret != 0)
+    return (uint16_t)ret;
+  for (uint32_t i = 0; i < cnt; i++)
+    vec[i] = buf + (hvec[i] - (uint32_t)(uintptr_t)hbuf);
+  memcpy(buf, hbuf, bufsz);
+  return 0;
+}
+
+__wasi_errno_t __wasi_args_get(uint8_t **argv, uint8_t *argv_buf) {
+  return m64_table_get(__imported_wasi_snapshot_preview1_args_sizes_get,
+                       __imported_wasi_snapshot_preview1_args_get, argv,
+                       argv_buf);
+}
+
+/* size_t results cross as u32: read them into slots and widen. */
+static __wasi_errno_t m64_two_sizes(int32_t (*f)(int32_t, int32_t),
+                                    __wasi_size_t *retptr0,
+                                    __wasi_size_t *retptr1) {
+  m64_check();
+  int32_t ret = f(M64P(&__m64_slot.u32[0]), M64P(&__m64_slot.u32[1]));
+  if (ret == 0) {
+    *retptr0 = __m64_slot.u32[0];
+    *retptr1 = __m64_slot.u32[1];
+  }
+  return (uint16_t)ret;
+}
+
+__wasi_errno_t __wasi_args_sizes_get(__wasi_size_t *retptr0,
+                                     __wasi_size_t *retptr1) {
+  return m64_two_sizes(__imported_wasi_snapshot_preview1_args_sizes_get,
+                       retptr0, retptr1);
+}
+
+int32_t __imported_wasi_snapshot_preview1_environ_get(int32_t arg0,
+                                                      int32_t arg1)
+    __attribute__((__import_module__("wasi_snapshot_preview1"),
+                   __import_name__("environ_get")));
+int32_t __imported_wasi_snapshot_preview1_environ_sizes_get(int32_t arg0,
+                                                            int32_t arg1)
+    __attribute__((__import_module__("wasi_snapshot_preview1"),
+                   __import_name__("environ_sizes_get")));
+
+__wasi_errno_t __wasi_environ_get(uint8_t **environ, uint8_t *environ_buf) {
+  return m64_table_get(__imported_wasi_snapshot_preview1_environ_sizes_get,
+                       __imported_wasi_snapshot_preview1_environ_get, environ,
+                       environ_buf);
+}
+
+__wasi_errno_t __wasi_environ_sizes_get(__wasi_size_t *retptr0,
+                                        __wasi_size_t *retptr1) {
+  return m64_two_sizes(__imported_wasi_snapshot_preview1_environ_sizes_get,
+                       retptr0, retptr1);
+}
+
+int32_t __imported_wasi_snapshot_preview1_clock_res_get(int32_t arg0,
+                                                        int32_t arg1)
+    __attribute__((__import_module__("wasi_snapshot_preview1"),
+                   __import_name__("clock_res_get")));
+
+__wasi_errno_t __wasi_clock_res_get(__wasi_clockid_t id,
+                                    __wasi_timestamp_t *retptr0) {
+  m64_check();
+  int32_t ret = __imported_wasi_snapshot_preview1_clock_res_get(
+      (int32_t)id, M64_OUTP(retptr0, &__m64_slot.u64));
+  M64_OUTFIX(ret, retptr0, &__m64_slot.u64);
+  return (uint16_t)ret;
+}
+
+int32_t __imported_wasi_snapshot_preview1_clock_time_get(int32_t arg0,
+                                                         int64_t arg1,
+                                                         int32_t arg2)
+    __attribute__((__import_module__("wasi_snapshot_preview1"),
