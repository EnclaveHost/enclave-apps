# RISC Box guest kernel fragment (on top of the riscv arch defconfig).
# The display: the emulator's DTB declares a simple-framebuffer at
# 0x87e00000 — FB_SIMPLE picks it up as /dev/fb0, fbcon puts the console on
# it, Xorg's fbdev driver runs the desktop.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=y
# Xorg wants SysV SHM (MIT-SHM) and unix sockets; both are defconfig-on for
# riscv but pinned here because the desktop dies confusingly without them.
CONFIG_SYSVIPC=y
CONFIG_UNIX=y
# the emulator's device set (virtio-mmio block + net, 16550 UART) — all in
# the riscv defconfig, pinned for the same reason as above
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_EXT4_FS=y
# risc-box patch: the emulator's virtio-input device (0x10003000) — the
# machine's HID. VIRTIO_INPUT binds it, EVDEV exposes /dev/input/eventN, and
# X's libinput driver reads that. Input core + evdev are what a graphical
# session (and a remote client injecting mouse/keyboard) reach the desktop
# through.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_VIRTIO_INPUT=y
# risc-box: the emulator's virtio-sound device (0x10004000) — the machine's
# sound card. The riscv defconfig leaves CONFIG_SOUND off entirely, so none of
# sound/ is reachable without this: no /dev/snd, and ALSA userspace (already in
# the image as libasound) has nothing to open. SND_VIRTIO selects SND_PCM and
# SND_JACK itself; SOUND and SND are the gates above it.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_VIRTIO=y
# risc-box: the emulator's virtio-gpu device (0x10005000) — a real DRM/KMS
# display controller alongside the simple-framebuffer above. DRM_VIRTIO_GPU is
# what turns the mmio node into /dev/dri/card0, which is the device modern
# userspace looks for: SDL's KMSDRM backend, Xorg's modesetting driver,
# anything Wayland. FBDEV_EMULATION keeps /dev/fb0 working on top of it so the
# console and the existing fbdev path do not regress, and DRM_FBDEV_OVERALLOC
# is left at its default.
#
# Both display paths coexist deliberately: a kernel built WITHOUT these still
# binds the simple-framebuffer and boots unchanged, so this fragment is
# additive and an older image is never stranded.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
