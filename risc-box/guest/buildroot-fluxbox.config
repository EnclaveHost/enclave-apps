# RISC Box "fluxbox" guest image — Buildroot defconfig (tested on 2024.02.x LTS).
#
# The lightweight desktop that is actually usable. Matchbox was lighter still
# and measured beautifully, but its application launcher IS matchbox-desktop,
# which segfaults in libmb on riscv64 — so a matchbox session without it is a
# window manager, an empty panel, and no way to start anything. Fast, and not a
# desktop.
#
# fluxbox carries its launcher and its taskbar in the one binary: right-click
# the root for the menu, and the toolbar along the bottom lists windows and
# workspaces. Nothing to crash separately, and nothing extra to package. Its
# dependencies are X11, freetype and imlib2 — no GTK, no glib, no pango, and
# no OpenGL provider, which is what made XFCE heavy.
#
#   guest/build.sh <buildroot-tree> <build-dir> guest/buildroot-fluxbox.config
BR2_riscv=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_RISCV64_LP64D_GLIBC_STABLE=y
# fluxbox is C++.
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_INSTALL_LIBSTDCPP=y
BR2_TARGET_GENERIC_HOSTNAME="riscbox"
BR2_TARGET_GENERIC_ISSUE="RISC Box fluxbox guest"
BR2_TARGET_GENERIC_ROOT_PASSWD="riscbox"
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_SYSTEM_DHCP=""
BR2_GLOBAL_PATCH_DIR="$(RISCBOX_GUEST)/patches"
BR2_ROOTFS_OVERLAY="$(RISCBOX_GUEST)/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(RISCBOX_GUEST)/post-build.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="5.15.164"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(RISCBOX_GUEST)/kernel.fragment"
BR2_LINUX_KERNEL_IMAGE=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XSERVER_XORG_SERVER_MODULAR=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_FBDEV=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_LIBINPUT=y
BR2_PACKAGE_XAPP_XSETROOT=y
BR2_PACKAGE_XLIB_LIBX11=y
# twm stays as the fallback session (see xdesktop.sh): a machine reachable only
# through a framebuffer is miserable to debug with an empty root window.
BR2_PACKAGE_XAPP_TWM=y
# The desktop: window manager, root menu and toolbar, all one binary.
BR2_PACKAGE_FLUXBOX=y
# Terminals and a file-ish tool, so the menu has something worth opening.
BR2_PACKAGE_XTERM=y
# One scalable font. fluxbox renders labels through Xft; without a font the
# menu and toolbar come up empty — the trap both other desktops hit.
BR2_PACKAGE_DEJAVU=y
# ext2 for the same reason the other guests use it (an ext4 journal-inode read
# hangs the vendored virtio-blk). Sized to content: no GTK and no icon theme
# means this stays small, which matters twice — the app holds the whole image
# in wasm32 linear memory beside the guest's DRAM, and the fetch blocks boot.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_2=y
BR2_TARGET_ROOTFS_EXT2_SIZE="128M"
