<?xml version="1.0" encoding="UTF-8"?>
<!--
  xfwm4 defaults for the RISC Box guest.

  This machine draws into a simple-framebuffer with no GL and an emulated CPU
  in the tens of MIPS, and every pixel it produces is then re-encoded and
  streamed. The settings here all buy the same thing: fewer pixels touched per
  interaction.

  use_compositing is the one that matters most. The compositor would redraw
  through Xrender on the CPU for shadows and transparency nobody asked for,
  and it turns every window move into a full-screen repaint. Off, xfwm4 does
  plain unredirected drawing, which is what this framebuffer wants.
-->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="use_compositing" type="bool" value="false"/>
    <!-- Outline move/resize instead of repainting window contents live. -->
    <property name="box_move" type="bool" value="true"/>
    <property name="box_resize" type="bool" value="true"/>
    <!-- No wireframe animations or cycling previews. -->
    <property name="cycle_draw_frame" type="bool" value="false"/>
    <property name="cycle_preview" type="bool" value="false"/>
    <property name="show_frame_shadow" type="bool" value="false"/>
    <property name="show_popup_shadow" type="bool" value="false"/>
    <!-- Snapping is cheap and makes an 800x600 desktop far easier to drive. -->
    <property name="snap_to_border" type="bool" value="true"/>
    <property name="snap_to_windows" type="bool" value="true"/>
    <property name="wrap_workspaces" type="bool" value="false"/>
  </property>
</channel>
