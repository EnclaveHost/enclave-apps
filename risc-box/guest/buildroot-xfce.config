# RISC Box "xfce" guest image — Buildroot defconfig (tested on 2024.02.x LTS).
#
# The xorg guest (guest/buildroot.config) plus a real desktop environment.
# Everything in that file's header still applies — same emulator constraints,
# same version pins, same reason for ext2 and the xkbcomp patch — this adds
# XFCE 4.18 on top and grows the image to fit it.
#
# XFCE is NOT carried by Buildroot (checked through master), so the packages
# live in guest/br2-external and the build needs BR2_EXTERNAL pointed at it.
# guest/build.sh does that; it takes the defconfig as its third argument:
#   guest/build.sh <buildroot-tree> <build-dir> guest/buildroot-xfce.config
#
# Expectation setting: this is a full GTK3 desktop on an emulated RV64GC CPU
# running in the tens of MIPS with a software framebuffer and no GL. It boots
# and it is driveable, but session startup is minutes and interaction is
# deliberate rather than snappy. The lighter twm image remains the right
# choice when responsiveness matters more than having a desktop environment.
BR2_riscv=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_RISCV64_LP64D_GLIBC_STABLE=y
BR2_TARGET_GENERIC_HOSTNAME="riscbox"
BR2_TARGET_GENERIC_ISSUE="RISC Box xfce guest"
BR2_TARGET_GENERIC_ROOT_PASSWD="riscbox"
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_SYSTEM_DHCP=""
BR2_GLOBAL_PATCH_DIR="$(RISCBOX_GUEST)/patches"
BR2_ROOTFS_OVERLAY="$(RISCBOX_GUEST)/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(RISCBOX_GUEST)/post-build.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="5.15.164"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(RISCBOX_GUEST)/kernel.fragment"
BR2_LINUX_KERNEL_IMAGE=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XSERVER_XORG_SERVER_MODULAR=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_FBDEV=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_LIBINPUT=y
BR2_PACKAGE_XAPP_TWM=y
BR2_PACKAGE_XAPP_XSETROOT=y
BR2_PACKAGE_XLIB_LIBX11=y
# XFCE reaches xfconfd and the session manager over a session bus, and
# dbus-run-session (from this package) is what creates one at login.
BR2_PACKAGE_DBUS=y
# GTK3 with the X11 backend: the toolkit every XFCE component is written in.
BR2_PACKAGE_LIBGTK3=y
BR2_PACKAGE_LIBGTK3_X11=y
# Buildroot's GTK3 hard-depends on an OpenGL provider even though nothing here
# draws with GL, so supply the cheapest one that satisfies it: Mesa's Gallium
# swrast behind GLX. Deliberately WITHOUT BR2_PACKAGE_MESA3D_LLVM — llvmpipe
# would drag LLVM into the target for a machine that will never call glxgears.
# The desktop still renders through cairo on the CPU exactly as twm did.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=y
# Without a font, every GTK label renders empty; without an icon theme the
# panel and desktop come up as blank buttons. Both are what makes the result
# a desktop rather than a screenshot of one.
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_HICOLOR_ICON_THEME=y
BR2_PACKAGE_ADWAITA_ICON_THEME=y
BR2_PACKAGE_SHARED_MIME_INFO=y
# XFCE 4.18, from guest/br2-external. Dependency order is handled by the
# packages themselves; these are the ones worth having on by name.
BR2_PACKAGE_LIBWNCK3=y
BR2_PACKAGE_LIBXFCE4UTIL=y
BR2_PACKAGE_XFCONF=y
BR2_PACKAGE_LIBXFCE4UI=y
BR2_PACKAGE_GARCON=y
BR2_PACKAGE_EXO=y
BR2_PACKAGE_XFWM4=y
BR2_PACKAGE_XFCE4_PANEL=y
BR2_PACKAGE_XFDESKTOP=y
BR2_PACKAGE_XAPP_ICEAUTH=y
BR2_PACKAGE_XFCE4_SESSION=y
BR2_PACKAGE_XFCE4_SETTINGS=y
BR2_PACKAGE_THUNAR=y
# ext2 for the same reason the xorg guest uses it (an ext4 journal-inode read
# hangs the vendored virtio-blk). GTK3 + XFCE + the icon theme do not fit in
# 96 MiB, so the image grows; it is still loaded whole from S3 at boot, which
# is the cost of the bigger desktop.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_2=y
BR2_TARGET_ROOTFS_EXT2_SIZE="768M"
