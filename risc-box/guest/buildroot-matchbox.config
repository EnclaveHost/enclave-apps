# RISC Box "matchbox" guest image — Buildroot defconfig (tested on 2024.02.x LTS).
#
# A real desktop environment that is honest about the hardware. XFCE proved the
# machine CAN run a full GTK3 desktop, and also that it costs about ten minutes
# to first paint on an emulated core in the tens of MIPS. Matchbox was written
# for handhelds with exactly this shape of problem — a slow CPU, little RAM, a
# framebuffer — and Buildroot already carries the whole family, so unlike XFCE
# it needs no packages of our own.
#
# The dependency list is the reason to expect it to be quicker. XFCE pulls
# GTK3, which pulls Mesa (GTK3 hard-depends on a GL provider), plus the Adwaita
# icon theme at 42 MiB and ~6000 files. Matchbox's window manager, desktop and
# panel need matchbox-lib, Xext, Xpm, expat and zlib — no toolkit at all. Every
# GTK3 startup cost XFCE pays per process (linking a ~8 MiB library, parsing
# the theme CSS, building icon caches) simply does not exist here.
#
#   guest/build.sh <buildroot-tree> <build-dir> guest/buildroot-matchbox.config
BR2_riscv=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_RISCV64_LP64D_GLIBC_STABLE=y
BR2_TARGET_GENERIC_HOSTNAME="riscbox"
BR2_TARGET_GENERIC_ISSUE="RISC Box matchbox guest"
BR2_TARGET_GENERIC_ROOT_PASSWD="riscbox"
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_SYSTEM_DHCP=""
BR2_GLOBAL_PATCH_DIR="$(RISCBOX_GUEST)/patches"
BR2_ROOTFS_OVERLAY="$(RISCBOX_GUEST)/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(RISCBOX_GUEST)/post-build.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="5.15.164"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(RISCBOX_GUEST)/kernel.fragment"
BR2_LINUX_KERNEL_IMAGE=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XSERVER_XORG_SERVER_MODULAR=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_FBDEV=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_LIBINPUT=y
BR2_PACKAGE_XAPP_XSETROOT=y
BR2_PACKAGE_XLIB_LIBX11=y
# twm stays in the image as the fallback session: xdesktop.sh drops back to it
# if the desktop fails to come up three times, and a machine reachable only
# through a framebuffer is miserable to debug with an empty root window.
BR2_PACKAGE_XAPP_TWM=y
# The desktop itself. matchbox-common carries the session script and the
# .desktop files the desktop folder and panel menu read.
#
# BR2_PACKAGE_MATCHBOX is the window manager AND the menuconfig that every
# other matchbox symbol lives inside (`if BR2_PACKAGE_MATCHBOX` in its
# Config.in). Without it the children are not merely off, they are invisible,
# and Buildroot drops unknown symbols from a defconfig SILENTLY — the build
# then succeeds and quietly produces an image with no desktop in it.
BR2_PACKAGE_MATCHBOX=y
BR2_PACKAGE_MATCHBOX_LIB=y
BR2_PACKAGE_MATCHBOX_SM=y
BR2_PACKAGE_MATCHBOX_COMMON=y
BR2_PACKAGE_MATCHBOX_DESKTOP=y
BR2_PACKAGE_MATCHBOX_PANEL=y
# A terminal, so the desktop is something you can actually do work in rather
# than only look at.
BR2_PACKAGE_XTERM=y
# One scalable font. Matchbox renders through Xft, so without a font every
# label comes out empty — the same trap XFCE hit.
BR2_PACKAGE_DEJAVU=y
# ext2 for the same reason the other guests use it (an ext4 journal-inode read
# hangs the vendored virtio-blk). No GTK3, no Mesa and no icon theme means the
# installed tree is a fraction of XFCE's ~143 MiB, so this can be small — and
# small matters twice, because the app holds the whole image in its wasm32
# linear memory beside the guest's DRAM, and because the fetch blocks boot.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_2=y
BR2_TARGET_ROOTFS_EXT2_SIZE="128M"
