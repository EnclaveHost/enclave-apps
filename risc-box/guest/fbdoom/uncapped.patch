 //
 // R_SetupFrame
 //
+// risc-box: shortest-path angular blend for interpolated rendering.
+// The unsigned difference cast to signed picks the short way around.
+angle_t R_InterpolateAngle (angle_t from, angle_t to, fixed_t frac)
+{
+    return from + (angle_t)((int64_t)(int32_t)(to - from) * frac / FRACUNIT);
+}
+
+// risc-box: whether this frame may be drawn between tics. Stale snapshots
+// (menu pause, spawn, teleport) fall back per-object in the guards below.
+boolean R_InterpolateThisFrame (void)
+{
+    return uncapped && !paused && gamestate == GS_LEVEL
+        && fractionaltic >= 0 && fractionaltic < FRACUNIT;
+}
+
 void R_SetupFrame (player_t* player)
 {		
     int		i;
     
     viewplayer = player;
-    viewx = player->mo->x;
-    viewy = player->mo->y;
