+    int64_t next_frame_ms = 0;
+
     while (1)
     {
 		// frame syncronous IO operations
 		I_StartFrame ();
 
+		if (uncapped && fpsmax > 0)
+		{
+			int64_t now = I_GetTimeMS();
+			if (next_frame_ms == 0)
+				next_frame_ms = now;
+			if (now < next_frame_ms)
+				I_Sleep((int)(next_frame_ms - now));
+			next_frame_ms += 1000 / fpsmax;
+			// after a stall, resume from now instead of racing the backlog
+			if (now > next_frame_ms + 250)
+				next_frame_ms = now;
+		}
+
 		TryRunTics (); // will run at least one tic
 
+		// sub-tic phase of the wall clock, for interpolated rendering
+		fractionaltic = (fixed_t)(((int64_t)I_GetTimeMS() * TICRATE % 1000)
+		                          * FRACUNIT / 1000);
