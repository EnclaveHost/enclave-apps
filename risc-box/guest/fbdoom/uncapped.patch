-    extralight = player->extralight;
 
-    viewz = player->viewz;
+    if (R_InterpolateThisFrame() && player->mo->interp == gametic - 1)
+    {
+        mobj_t* mo = player->mo;
+        viewx = mo->oldx + FixedMul (fractionaltic, mo->x - mo->oldx);
+        viewy = mo->oldy + FixedMul (fractionaltic, mo->y - mo->oldy);
+        viewangle = R_InterpolateAngle (mo->oldangle, mo->angle,
+                                        fractionaltic) + viewangleoffset;
+        viewz = player->oldviewz
+              + FixedMul (fractionaltic, player->viewz - player->oldviewz);
+    }
+    else
+    {
+        viewx = player->mo->x;
+        viewy = player->mo->y;
+        viewangle = player->mo->angle + viewangleoffset;
+        viewz = player->viewz;
+    }
+
+    extralight = player->extralight;
     
     viewsin = finesine[viewangle>>ANGLETOFINESHIFT];
     viewcos = finecosine[viewangle>>ANGLETOFINESHIFT];
