config BR2_PACKAGE_XFCE4_SETTINGS
	bool "xfce4-settings"
	select BR2_PACKAGE_LIBXFCE4UI
	select BR2_PACKAGE_LIBXFCE4UTIL
	select BR2_PACKAGE_XFCONF
	select BR2_PACKAGE_GARCON
	select BR2_PACKAGE_EXO
	select BR2_PACKAGE_XLIB_LIBXI
	select BR2_PACKAGE_FONTCONFIG
	select BR2_PACKAGE_XLIB_LIBX11
	select BR2_PACKAGE_LIBGTK3
	select BR2_PACKAGE_LIBGTK3_X11
	depends on BR2_PACKAGE_XORG7
	depends on BR2_USE_MMU
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  XFCE desktop component: xfce4-settings.

	  https://docs.xfce.org/
