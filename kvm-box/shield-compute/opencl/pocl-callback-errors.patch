diff --git a/lib/CL/clSetEventCallback.c b/lib/CL/clSetEventCallback.c
index a82e7e0..198afbd 100644
--- a/lib/CL/clSetEventCallback.c
+++ b/lib/CL/clSetEventCallback.c
@@ -35,10 +35,14 @@ POname(clSetEventCallback) (cl_event     event ,
     }
   else
     {
+      cl_int callback_status = event->status < CL_COMPLETE
+                                 ? event->status : cb_ptr->trigger_status;
+      POCL_RETAIN_OBJECT_UNLOCKED (event);
       POCL_UNLOCK_OBJ (event);
-      cb_ptr->callback_function (event, cb_ptr->trigger_status, 
+      cb_ptr->callback_function (event, callback_status,
                                  cb_ptr->user_data);
       free (cb_ptr);
+      POname (clReleaseEvent) (event);
     }
   
 
diff --git a/lib/CL/clSetUserEventStatus.c b/lib/CL/clSetUserEventStatus.c
index d15790b..a21c281 100644
--- a/lib/CL/clSetUserEventStatus.c
+++ b/lib/CL/clSetUserEventStatus.c
@@ -12,6 +12,8 @@ CL_API_SUFFIX__VERSION_1_1
   /* Can only be set to CL_COMPLETE (0) or negative values */
   POCL_RETURN_ERROR_COND ((execution_status > CL_COMPLETE), CL_INVALID_VALUE);
 
+  /* A callback may release the application's last reference. */
+  POname (clRetainEvent) (event);
   POCL_LOCK_OBJ (event);
 
   POCL_GOTO_ERROR_COND ((event->command_type != CL_COMMAND_USER),
@@ -37,6 +39,7 @@ CL_API_SUFFIX__VERSION_1_1
 
 ERROR:
   POCL_UNLOCK_OBJ (event);
+  POname (clReleaseEvent) (event);
   return errcode;
 }
 POsym(clSetUserEventStatus)
diff --git a/lib/CL/pocl_tracing.c b/lib/CL/pocl_tracing.c
