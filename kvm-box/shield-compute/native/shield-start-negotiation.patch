+// A deliberate graph re-registration can race the old worker reservation's
+// cleanup. Retry only pre-work connection/HELLO negotiation, at most twice.
+// Public uploads, pad preparation and every matrix exchange remain fail-closed.
+static int sh_start_with_policy(sh_link *link) {
+    int rc = sh_link_start(link);
+    for (unsigned retry = 0; rc != SH_OK && retry < 2 &&
+            g_require_offload.load() && sh_link_start_retryable(link); ++retry) {
+        fprintf(stderr, "[shielded] retrying pre-work negotiation (%u/2)\n", retry + 1);
+        usleep(100000u << retry);
+        rc = sh_link_start(link);
+    }
+    return rc;
