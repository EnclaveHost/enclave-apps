+// GGML names can exceed the wire protocol's 63-byte limit. Authenticate
+// their full names above this layer; use a lossless-length SHA-256 identity
+// (base32, 52 characters) for the public wire label, without truncating names.
+#include "shielded-sha256.h"
+static std::string sh_wire_name(const std::string &name) {
+    uint8_t hash[32]; sha256_ctx ctx;
+    sha_init(&ctx); sha_update(&ctx, (const uint8_t *)name.data(), name.size()); sha_final(&ctx, hash);
+    static const char alphabet[] = "abcdefghijklmnopqrstuvwxyz234567";
+    std::string out = "w_";
+    uint32_t bits = 0; unsigned count = 0;
+    for (uint8_t byte : hash) {
+        bits = (bits << 8) | byte; count += 8;
+        while (count >= 5) { count -= 5; out += alphabet[(bits >> count) & 31]; }
+    }
+    if (count) out += alphabet[(bits << (5-count)) & 31];
+    return out;
+}
