--- /dev/null
+++ b/src/core/ggml_graph_operations.h
@@ -0,0 +1,56 @@
+#ifndef __SD_CORE_GGML_GRAPH_OPERATIONS_H__
+#define __SD_CORE_GGML_GRAPH_OPERATIONS_H__
+
+#include "ggml.h"
+
+// A CPU operation cannot write in place into an OpenCL allocation. During
+// mixed-backend graph construction, leave temporary output allocation to the
+// scheduler. Persistent inputs and weights retain their mutation semantics.
+inline thread_local ggml_context* sd_out_of_place_graph_context = nullptr;
+
+struct SDGraphOutOfPlaceScope {
+    ggml_context* previous;
+    SDGraphOutOfPlaceScope(ggml_context* ctx, bool enabled)
+        : previous(sd_out_of_place_graph_context) {
+        if (enabled) {
+            sd_out_of_place_graph_context = ctx;
+        }
+    }
+    ~SDGraphOutOfPlaceScope() { sd_out_of_place_graph_context = previous; }
+    SDGraphOutOfPlaceScope(const SDGraphOutOfPlaceScope&) = delete;
+    SDGraphOutOfPlaceScope& operator=(const SDGraphOutOfPlaceScope&) = delete;
+};
+
+static inline bool sd_graph_use_inplace(ggml_context* ctx, ggml_tensor* input) {
+    if (ctx != sd_out_of_place_graph_context) {
+        return true;
+    }
+    const ggml_tensor* root = input->view_src ? input->view_src : input;
+    return root->op == GGML_OP_NONE || root->buffer != nullptr || root->data != nullptr;
+}
+
+#define SD_GRAPH_UNARY_OP(name) \
+    static inline ggml_tensor* sd_graph_##name##_inplace(ggml_context* ctx, ggml_tensor* a) { \
+        return sd_graph_use_inplace(ctx, a) ? ggml_##name##_inplace(ctx, a) : ggml_##name(ctx, a); \
+    }
+SD_GRAPH_UNARY_OP(relu)
+SD_GRAPH_UNARY_OP(silu)
+SD_GRAPH_UNARY_OP(tanh)
+SD_GRAPH_UNARY_OP(gelu)
+SD_GRAPH_UNARY_OP(gelu_quick)
+SD_GRAPH_UNARY_OP(soft_max)
+#undef SD_GRAPH_UNARY_OP
+
+#define SD_GRAPH_BINARY_OP(name) \
+    static inline ggml_tensor* sd_graph_##name##_inplace(ggml_context* ctx, ggml_tensor* a, ggml_tensor* b) { \
+        return sd_graph_use_inplace(ctx, a) ? ggml_##name##_inplace(ctx, a, b) : ggml_##name(ctx, a, b); \
+    }
+SD_GRAPH_BINARY_OP(add)
+SD_GRAPH_BINARY_OP(mul)
+#undef SD_GRAPH_BINARY_OP
+
+static inline ggml_tensor* sd_graph_scale_inplace(ggml_context* ctx, ggml_tensor* a, float scale) {
+    return sd_graph_use_inplace(ctx, a) ? ggml_scale_inplace(ctx, a, scale) : ggml_scale(ctx, a, scale);
+}
+
+#endif
