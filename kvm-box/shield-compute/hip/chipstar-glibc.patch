+// glibc 2.41 also enables binary128 from the compiler version, independent
+// of __FLOAT128__. SPIR-V has no binary128 type. Suppress only that header's
+// compiler-version detection during the device pass, restoring it afterward.
+#if defined(__linux__) && defined(__x86_64__)
+#include <features.h>
+#if defined(__GLIBC__)
+#pragma push_macro("__GNUC_PREREQ")
+#pragma push_macro("__glibc_clang_prereq")
+#undef __GNUC_PREREQ
+#undef __glibc_clang_prereq
+#define __GNUC_PREREQ(major, minor) 0
+#define __glibc_clang_prereq(major, minor) 0
+#include <bits/floatn.h>
+#pragma pop_macro("__glibc_clang_prereq")
+#pragma pop_macro("__GNUC_PREREQ")
+#endif
+#endif
+
 #endif // __HIP_DEVICE_COMPILE__
 
 
