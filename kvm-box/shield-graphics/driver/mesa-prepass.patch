+/* Experimental structural admission. The original CPU NIR stays untouched.
+ * This contract is conditional on the complete handle_shield_prepass guards. */
+static struct shield_nir_proof
+lvp_prove_prepass(nir_shader *original)
+{
+   nir_function_impl *entry = nir_shader_get_entrypoint(original);
+   if (!entry || entry->ssa_alloc > 4096)
+      return (struct shield_nir_proof){.contract=SHIELD_NIR_NONE,.reason=SHIELD_NIR_LIMIT};
+   nir_shader *nir = nir_shader_clone(NULL, original);
+   if (!nir)
+      return (struct shield_nir_proof){.contract=SHIELD_NIR_NONE,.reason=SHIELD_NIR_LIMIT};
+   bool settled = false;
+   for (unsigned iteration = 0; iteration < 16; ++iteration) {
+      bool progress = false;
+      NIR_PASS(progress, nir, nir_lower_vars_to_ssa);
+      NIR_PASS(progress, nir, nir_copy_prop);
+      NIR_PASS(progress, nir, nir_opt_deref);
+      NIR_PASS(progress, nir, nir_opt_constant_folding);
+      NIR_PASS(progress, nir, nir_opt_algebraic);
+      NIR_PASS(progress, nir, nir_opt_copy_prop_vars);
+      NIR_PASS(progress, nir, nir_opt_dead_write_vars);
+      NIR_PASS(progress, nir, nir_opt_combine_stores, nir_var_all);
+      NIR_PASS(progress, nir, nir_remove_dead_variables, nir_var_function_temp, NULL);
+      NIR_PASS(progress, nir, nir_opt_dce);
+      NIR_PASS(progress, nir, nir_opt_cse);
+      NIR_PASS(progress, nir, nir_opt_dead_cf);
+      if (!progress) { settled = true; break; }
+   }
+   struct shield_nir_proof proof = {.contract=SHIELD_NIR_NONE,.reason=SHIELD_NIR_LIMIT};
+   if (settled) {
+      nir_validate_shader(nir, "experimental Shield proof input");
+      proof = shield_prepass_prove_nir(nir);
+   }
+   ralloc_free(nir);
+   return proof;
+}
