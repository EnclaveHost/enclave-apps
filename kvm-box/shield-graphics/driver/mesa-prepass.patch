+/* Fixed 64x4 prepass only. Routing uses shader/grid/descriptor metadata, never
+ * private values. Prior writes complete before input snapshot. Unsupported
+ * layouts retain the original CPU shader. A started request never retries. */
+static bool
+handle_shield_prepass(struct rendering_state *state)
+{
+   if (!state->shield_prepass || state->shield_generated_depth ||
+       state->shield_active_queries || state->dispatch_info.grid[0] != 1 ||
+       state->dispatch_info.grid[1] != 1 || state->dispatch_info.grid[2] != 1 ||
+       state->dispatch_info.block[0] != 64 || state->dispatch_info.block[1] != 1 ||
+       state->dispatch_info.block[2] != 1)
+      return false;
+   for (unsigned i = 0; i < ARRAY_SIZE(state->desc_buffers); ++i)
+      if (state->desc_buffers[i])
+         return false;
+   struct lvp_descriptor_set *set = state->desc_sets[LVP_PIPELINE_COMPUTE][0];
+   if (!set || !set->layout || set->layout->binding_count != 2 || !set->map ||
+       set->layout->dynamic_offset_count != 0)
+      return false;
+   struct lp_jit_buffer buffers[2];
+   for (unsigned i = 0; i < 2; ++i) {
+      const struct lvp_descriptor_set_binding_layout *binding = &set->layout->binding[i];
+      if (!binding->valid || binding->type != VK_DESCRIPTOR_TYPE_STORAGE_BUFFER ||
+          binding->array_size != 1 ||
+          binding->descriptor_index >= set->layout->size)
+         return false;
+      buffers[i] = ((const struct lp_descriptor *)set->map)[binding->descriptor_index].buffer;
+      /* num_elements in this BDA descriptor is a BYTE count (lp_jit.c). */
+      if (!buffers[i].u || buffers[i].num_elements != 1024 ||
+          ((uintptr_t)buffers[i].u & 3) || (uintptr_t)buffers[i].u > UINTPTR_MAX - 1024)
+         return false;
+   }
+   uintptr_t a = (uintptr_t)buffers[0].u, b = (uintptr_t)buffers[1].u;
+   if (a < b + 1024 && b < a + 1024)
+      return false;
+   finish_fence(state);
+   uint32_t snapshot[256];
+   int32_t result[256];
+   memcpy(snapshot, buffers[0].u, sizeof(snapshot));
+   enum shield_prepass_result status = shield_prepass_execute(snapshot, result);
+   explicit_bzero(snapshot, sizeof(snapshot));
+   if (status == SHIELD_PREPASS_UNAVAILABLE)
+      return false;
+   if (status == SHIELD_PREPASS_FAILED) {
+      state->shield_failed = true;
+      return true;
+   }
+   memcpy((void *)buffers[1].u, result, sizeof(result));
+   explicit_bzero(result, sizeof(result));
+   return true;
+}
